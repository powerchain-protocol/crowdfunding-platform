    "react-dom": "19.2.8",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": "24.19.0"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
