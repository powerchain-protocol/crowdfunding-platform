    "./providers/solana-connector": "./src/shared/components/provider/solana-connector-provider.tsx",
    "./cookies": "./src/cookies.tsx",
    "./components/messages": "./src/components/messages/index.ts"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "dependencies": {
    "@powerchain/common": "workspace:*",
    "@powerchain/config": "workspace:*",
    "@powerchain/i18n": "workspace:*",
    "@powerchain/hooks": "workspace:*",
    "@web3icons/react": "4.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@solana-commerce/connector": "0.1.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "lint": "echo ui:lint"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
