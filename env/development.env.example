# Optional environment-specific template.
# Prefer root .env.local for normal Next.js development.
POWERCHAIN_ENV=development
POWERCHAIN_DATA_MODE=mock
POWERCHAIN_WRITE_MODE=simulated
POWERCHAIN_INFRA_REQUIRED=false
DATABASE_URL=postgresql://powerchain:powerchain_local_only@127.0.0.1:5432/powerchain?schema=public
REDIS_URL=redis://127.0.0.1:6379
NEXT_PUBLIC_API_URL=http://localhost:3010

SOLANA_MILESTONE_ESCROW_PROGRAM_ID=
SOLANA_MILESTONE_ESCROW_VERIFIED=false
