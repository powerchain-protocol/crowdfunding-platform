{
  "name": "powerchain-crowdfunding-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/assert-dev-stopped.mjs build && pnpm build:check && turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "clean": "node scripts/clean.mjs",
    "dev:web": "pnpm --filter @powerchain/web dev",
    "dev:crowdfunding": "pnpm --filter @powerchain/crowdfunding dev",
    "dev:donate": "pnpm --filter @powerchain/donate dev",
    "dev:checkout": "pnpm --filter @powerchain/checkout dev",
    "dev:dashboard": "pnpm --filter @powerchain/dashboard dev",
    "dev:treasury": "pnpm --filter @powerchain/treasury-app dev",
    "dev:admin": "pnpm --filter @powerchain/admin dev",
    "dev:explorer": "pnpm --filter @powerchain/explorer dev",
    "dev:docs": "pnpm --filter @powerchain/docs-app dev",
    "dev:pwa": "pnpm --filter @powerchain/pwa dev",
    "dev:api": "pnpm --filter @powerchain/api dev",
    "doctor": "node scripts/doctor.mjs",
    "validate:structure": "node scripts/validate-structure.mjs",
    "conformance": "node scripts/conformance.mjs",
    "version:check": "node scripts/version-lock.mjs",
    "validate": "pnpm version:check && pnpm supply-chain:check && pnpm postcss:check && pnpm runtime:check && pnpm workspace:check && pnpm config:check && pnpm env:check && pnpm docker:files:check && pnpm source:check && pnpm next:check && pnpm routes:check && pnpm skills:check && pnpm readmes:check && pnpm architecture:check && pnpm validate:structure && pnpm engine:check && pnpm saas:check && pnpm icons:check && pnpm conformance && pnpm shadcn:check && pnpm ui:check",
    "security:verify:production": "node scripts/verify-production-rls.mjs",
    "runtime:check": "node scripts/doctor.mjs",
    "engine:check": "node scripts/validate-crowdfunding-engine.mjs",
    "postinstall": "node scripts/prisma-install.mjs",
    "db:generate": "node scripts/prisma-cli.mjs generate",
    "db:validate": "node scripts/prisma-cli.mjs validate",
    "db:push": "node scripts/db-command.mjs push",
    "db:migrate": "node scripts/db-command.mjs migrate-dev",
    "db:migrate:deploy": "node scripts/db-command.mjs migrate-deploy",
    "db:seed": "node scripts/db-command.mjs seed",
    "stack:up": "node scripts/infra-compose.mjs up",
    "stack:down": "node scripts/infra-compose.mjs down",
    "stack:logs": "node scripts/infra-compose.mjs logs",
    "saas:check": "node scripts/validate-saas.mjs",
    "approve-builds": "pnpm approve-builds",
    "workspace:check": "node scripts/validate-workspace-deps.mjs",
    "config:check": "node scripts/validate-config.mjs",
    "predev": "pnpm runtime:check && pnpm prisma:schema:check && pnpm source:check && pnpm next:check",
    "db:format": "node scripts/prisma-cli.mjs format",
    "prisma:schema:check": "node scripts/validate-prisma-schema.mjs",
    "prisma:check": "pnpm prisma:schema:check && pnpm db:validate",
    "preinstall": "node scripts/assert-dev-stopped.mjs install && node scripts/validate-package-manager.mjs && node scripts/validate-prisma-schema.mjs && node scripts/validate-workspace-deps.mjs",
    "icons:check": "node scripts/validate-web3-icons.mjs",
    "doctor:project": "node scripts/doctor.mjs",
    "routes:check": "node scripts/validate-api-routes.mjs",
    "skills:check": "node scripts/validate-skills.mjs",
    "infra:check": "node scripts/check-infra.mjs",
    "stack:wait": "node scripts/wait-for-infra.mjs",
    "stack:status": "node scripts/infra-compose.mjs status",
    "dev:stack": "pnpm env:init && pnpm stack:up && pnpm stack:wait && pnpm db:generate && pnpm dev",
    "env:init": "node scripts/env-init.mjs",
    "env:reset": "node scripts/env-init.mjs --force",
    "readmes:check": "node scripts/validate-readmes.mjs",
    "setup:check": "pnpm package-manager:check && pnpm supply-chain:check && pnpm postcss:check && pnpm runtime:check && pnpm prisma:schema:check && pnpm workspace:check && pnpm config:check && pnpm env:check && pnpm docker:files:check && pnpm source:check && pnpm next:check && pnpm routes:check && pnpm skills:check && pnpm readmes:check && pnpm architecture:check && pnpm shadcn:check",
    "dev:turbo": "turbo run dev --filter=./apps/* --parallel --ui=stream",
    "source:check": "node scripts/validate-source-tree.mjs",
    "next:check": "node scripts/validate-next-install.mjs",
    "architecture:check": "node scripts/validate-architecture.mjs",
    "clean:deps": "node scripts/clean.mjs --deps",
    "package-manager:check": "node scripts/validate-package-manager.mjs",
    "repair:workspace": "node scripts/repair-workspace.mjs",
    "workspace:inventory": "node scripts/workspace-inventory.mjs",
    "docker:check": "node scripts/docker-doctor.mjs",
    "docker:files:check": "node scripts/validate-docker-security.mjs",
    "stack:build": "node scripts/infra-compose.mjs build",
    "stack:pull": "node scripts/infra-compose.mjs pull",
    "stack:app": "node scripts/infra-compose.mjs app",
    "env:check": "node scripts/validate-provider-env.mjs",
    "supply-chain:repair": "node scripts/repair-supply-chain.mjs",
    "supply-chain:check": "node scripts/validate-supply-chain.mjs",
    "clean:lockfile": "node scripts/clean.mjs --lockfile",
    "shadcn:check": "node scripts/validate-shadcn.mjs",
    "shadcn:info": "pnpm dlx shadcn@latest info -c apps/crowdfunding",
    "shadcn:info:ui": "pnpm dlx shadcn@latest info -c packages/ui",
    "shadcn:add": "pnpm dlx shadcn@latest add -c apps/crowdfunding",
    "shadcn:add:ui": "pnpm dlx shadcn@latest add -c packages/ui",
    "ui:check": "node scripts/validate-shared-ui.mjs",
    "postcss:check": "node scripts/validate-postcss.mjs",
    "build:check": "pnpm source:check && pnpm config:check && pnpm routes:check && pnpm shadcn:check && pnpm ui:check && pnpm postcss:check && node scripts/validate-build-surface.mjs",
    "ci:check": "pnpm validate && pnpm build:check && pnpm typecheck",
    "build:verified": "pnpm ci:check && pnpm build"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "8.5.23",
    "tailwindcss": "4.3.3",
    "turbo": "2.10.10",
    "typescript": "6.0.3",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "@prisma/client": "6.19.3"
  }
}
