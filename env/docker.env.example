# Docker-only local infrastructure values.
# Prefer `pnpm env:init` for normal development; this file documents the values
# consumed by infra/docker-compose.yml.
POWERCHAIN_DOCKER_BIND=127.0.0.1
NODE_VERSION=24.19.0
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_PORT=5432
POSTGRES_DB=powerchain
POSTGRES_USER=powerchain
POSTGRES_PASSWORD=powerchain_local_change_me
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 --auth-local=scram-sha-256
REDIS_IMAGE=redis:7-alpine
REDIS_PORT=6379
REDIS_PASSWORD=powerchain_redis_local_change_me
