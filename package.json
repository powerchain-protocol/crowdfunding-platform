{
  "name": "powerchain-crowdfunding-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules",
    "dev:web": "pnpm --filter @powerchain/web dev",
    "dev:crowdfunding": "pnpm --filter @powerchain/crowdfunding dev",
    "dev:donate": "pnpm --filter @powerchain/donate dev",
    "dev:checkout": "pnpm --filter @powerchain/checkout dev",
    "dev:dashboard": "pnpm --filter @powerchain/dashboard dev",
    "dev:treasury": "pnpm --filter @powerchain/treasury-app dev",
    "dev:admin": "pnpm --filter @powerchain/admin dev",
    "dev:explorer": "pnpm --filter @powerchain/explorer dev",
    "dev:docs": "pnpm --filter @powerchain/docs-app dev",
    "dev:pwa": "pnpm --filter @powerchain/pwa dev",
    "dev:api": "pnpm --filter @powerchain/api dev",
    "doctor": "node scripts/doctor.mjs",
    "validate:structure": "node scripts/validate-structure.mjs",
    "conformance": "node scripts/conformance.mjs",
    "version:check": "node scripts/version-lock.mjs",
    "validate": "pnpm version:check && pnpm runtime:check && pnpm validate:structure && pnpm engine:check && pnpm conformance",
    "security:verify:production": "node scripts/verify-production-rls.mjs",
    "runtime:check": "node scripts/doctor.mjs",
    "engine:check": "node scripts/validate-crowdfunding-engine.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "8.5.6",
    "tailwindcss": "4.3.3",
    "turbo": "2.5.6",
    "typescript": "^6.0.0"
  }
}
