# Production template: values are intentionally blank and must come from the
# deployment secret manager. Never put real secrets in source control.
NODE_ENV=production
POWERCHAIN_ENV=production
POWERCHAIN_DATA_MODE=tba
POWERCHAIN_WRITE_MODE=disabled
POWERCHAIN_INFRA_REQUIRED=true
DATABASE_URL=
REDIS_URL=
SOLANA_RPC_URL=
SUI_RPC_URL=
EVM_RPC_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MIDTRANS_SERVER_KEY=
MONERIUM_CLIENT_ID=

SOLANA_MILESTONE_ESCROW_PROGRAM_ID=
SOLANA_MILESTONE_ESCROW_VERIFIED=false
