generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Campaign {
  id            String   @id @default(cuid())
  organizationId  String?  @db.Uuid
  ownerUserId     String?  @db.Uuid
  summary         String?
  region          String?
  logoUrl         String?
  coverImageUrl   String?
  ownerAvatarUrl  String?
  raisedAmount    Decimal  @default(0) @db.Decimal(30, 9)
  deadline        DateTime?
  slug          String   @unique
  title         String
  purpose       String
  participation String
  status        String
  targetAmount  Decimal  @db.Decimal(30, 9)
  currency      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  paymentIntents PaymentIntent[]
}

model PaymentIntent {
  id              String   @id @default(cuid())
  campaignId      String
  amount          Decimal  @db.Decimal(30, 9)
  displayCurrency String
  paymentMethod   String
  settlementAsset String
  status          String
  reference       String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  campaign        Campaign @relation(fields: [campaignId], references: [id])
}

model AuditEvent {
  id                String   @id @default(cuid())
  sequence          BigInt   @unique @default(autoincrement())
  type              String
  actorId           String?
  organizationId    String?
  resourceType      String
  resourceId        String
  requestId         String?
  correlationId     String?
  metadata          Json?
  payloadHash       String
  previousEventHash String?
  eventHash         String   @unique
  createdAt         DateTime @default(now())
  @@index([resourceType, resourceId, sequence])
}

model VerificationCheck {
  id                String   @id @default(cuid())
  subjectId         String
  subjectType       String
  type              String
  status            String
  providerReference String?
  verifiedAt        DateTime?
  expiresAt         DateTime?
  reviewerId        String?
  reasonCode        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model IdentityDocument {
  id          String   @id @default(cuid())
  checkId     String
  kind        String
  fileName    String
  contentType String
  sizeBytes   Int
  sha256      String
  storageKey  String
  createdAt   DateTime @default(now())
  @@unique([checkId, sha256])
}

model AgreementTemplate {
  id                String
  name              String
  version           String
  jurisdiction      String?
  counselApprovedAt DateTime?
  counselReference  String?
  content           String
  contentHash       String
  createdAt         DateTime @default(now())
  @@id([id, version])
}

model Agreement {
  id                  String   @id @default(cuid())
  campaignId          String
  templateId          String
  templateVersion     String
  status              String
  dealTerms           Json
  renderedContentHash String
  supersedesId        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AgreementSignature {
  id                String   @id @default(cuid())
  agreementId       String
  signerUserId      String
  signerName        String
  signerRole        String
  signedContentHash String
  consentVersion    String
  requestId         String
  ipHash            String?
  userAgentHash     String?
  signedAt          DateTime @default(now())
  @@unique([agreementId, signerUserId, signedContentHash])
}

model CampaignEscrow {
  id         String   @id @default(cuid())
  campaignId String
  treasuryId String
  status     String
  asset      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EscrowTranche {
  id                   String   @id @default(cuid())
  escrowId             String
  campaignId           String
  milestoneId          String
  label                String
  amountMinor          Decimal  @db.Decimal(40, 0)
  asset                String
  status               String
  platformFeeBpsSnapshot Int?
  fundedAt             DateTime?
  releaseTransactionId String?
  releasedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  channel   String
  status    String
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model NotificationPreference {
  id        String @id @default(cuid())
  userId    String
  type      String
  inApp     Boolean @default(true)
  email     Boolean @default(true)
  @@unique([userId, type])
}

model ModerationReport {
  id             String   @id @default(cuid())
  reporterUserId String?
  resourceType   String
  resourceId     String
  reason         String
  details        String?
  status         String
  severity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([resourceType, resourceId, createdAt])
}

model ModerationAction {
  id         String   @id @default(cuid())
  reportId   String?
  resourceType String
  resourceId String
  action     String
  reasonCode String
  actorId    String?
  automatic  Boolean  @default(false)
  createdAt  DateTime @default(now())
}


model FounderListing {
  id                 String   @id @default(uuid()) @db.Uuid
  slug               String   @unique
  founderUserId      String   @db.Uuid
  organizationId     String   @db.Uuid
  productName        String
  tagline             String
  category            String
  stage               String
  location            String
  pitchDeckStorageKey String?
  demoVideoStorageKey String?
  status              String   @default("DRAFT")
  verificationStatus  String   @default("PENDING")
  verified            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("founder_listings")
}

model ListingTranche {
  id                String   @id @default(uuid()) @db.Uuid
  listingId         String   @db.Uuid
  ordinal           Int
  title             String
  amountMinor       Decimal  @db.Decimal(40, 0)
  milestoneSummary  String
  proofRequirements Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([listingId, ordinal])
  @@map("listing_tranches")
}

model InvestorOffer {
  id             String   @id @default(uuid()) @db.Uuid
  listingId      String   @db.Uuid
  investorUserId String   @db.Uuid
  amountMinor    Decimal  @db.Decimal(40, 0)
  currency       String
  termsJson      Json
  status         String   @default("SUBMITTED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("investor_offers")
}

model WatchlistItem {
  userId    String   @db.Uuid
  listingId String   @db.Uuid
  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@map("watchlist_items")
}

model DealRoom {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @db.Uuid
  offerId   String?  @db.Uuid
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@map("deal_rooms")
}

model DealRoomParticipant {
  roomId          String   @db.Uuid
  userId          String   @db.Uuid
  participantRole String
  createdAt       DateTime @default(now())

  @@id([roomId, userId])
  @@map("deal_room_participants")
}

model DealRoomMessage {
  id           String   @id @default(uuid()) @db.Uuid
  roomId       String   @db.Uuid
  senderUserId String   @db.Uuid
  kind         String
  body         String?
  createdAt    DateTime @default(now())
  editedAt     DateTime?

  @@map("deal_room_messages")
}

model DealRoomAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  roomId         String   @db.Uuid
  uploaderUserId String   @db.Uuid
  storageKey     String
  fileName       String
  contentType    String
  sizeBytes      BigInt
  sha256         String
  createdAt      DateTime @default(now())

  @@map("deal_room_attachments")
}

model MilestoneProof {
  id                   String   @id @default(uuid()) @db.Uuid
  escrowTrancheId      String   @db.Uuid
  submitterUserId      String   @db.Uuid
  ipfsUri              String
  sha256               String
  status               String   @default("SUBMITTED")
  verifiedByInvestorId String?  @db.Uuid
  verifiedAt           DateTime?
  createdAt            DateTime @default(now())

  @@map("milestone_proofs")
}

model OrganizationProfile {
  id                 String   @id @default(cuid())
  organizationId     String   @unique
  legalName          String
  tradingName        String?
  entityType         String
  registrationNumber String?
  taxId              String?
  foundationNumber   String?
  foundationPurpose  String?
  foundedAt          DateTime?
  website            String?
  billingEmail       String?
  phone              String?
  logoObjectKey      String?
  description        String?
  registeredAddress  Json?
  socialLinks        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model InvoiceRecord {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  status         String
  currency       String
  issuerSnapshot Json
  customerSnapshot Json
  lines          Json
  fees           Json?
  discountAmount Decimal? @db.Decimal(30, 9)
  settlement     Json?
  notes          String?
  paymentTerms   String?
  auditHash      String?
  issuedAt       DateTime
  dueAt          DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, status])
}


model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  primaryRole  String   @default("CREATOR")
  status       String   @default("ACTIVE")
  deletionRequestedAt DateTime?
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  memberships  OrganizationMembership[]
  usageEvents  UsageEvent[]
  passwordResetTokens PasswordResetToken[]
  preferences  UserPreference?
  trustedWallets TrustedWallet[]
  operatorProfile OperatorProfile?
  authIdentities AuthIdentity[]
  rpcSetting UserRpcSetting?
  savedPrompts SavedPrompt[]
  @@map("users")
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships OrganizationMembership[]
  subscriptions SaaSSubscription[]
  usageEvents UsageEvent[]
  @@map("organizations")
}

model OrganizationMembership {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  role           String   @default("OWNER")
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User @relation(fields:[userId], references:[id], onDelete:Cascade)
  organization   Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("organization_memberships")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  remembered Boolean @default(false)
  ipHash String?
  userAgentHash String?
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())
  user      User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, expiresAt])
  @@map("sessions")
}

model SaaSSubscription {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  planCode           String
  status             String   @default("TRIALING")
  provider           String?  
  providerCustomerId String?
  providerSubscriptionId String?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  organization       Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@index([organizationId, status])
  @@map("saas_subscriptions")
}

model UsageEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  metric         String
  quantity       Int      @default(1)
  idempotencyKey String   @unique
  metadata       Json?
  occurredAt     DateTime @default(now())
  organization   Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  user           User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  @@index([organizationId, metric, occurredAt])
  @@map("usage_events")
}



model UserPreference {
  userId          String   @id @db.Uuid
  defaultCurrency String   @default("USD")
  solanaNetwork   String   @default("devnet")
  theme           String   @default("system")
  locale          String   @default("en")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model TrustedWallet {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  organizationId       String?  @db.Uuid
  address              String
  network              String
  kind                 String   @default("PERSONAL")
  label                String?
  status               String   @default("ACTIVE")
  verifiedAt           DateTime?
  verificationSource   String?
  verifiedByOperatorId String?  @db.Uuid
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, address, network])
  @@index([organizationId, network])
  @@index([address, network])
  @@map("trusted_wallets")
}

model OperatorProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  operatorType String
  status       String   @default("ACTIVE")
  permissions  Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([operatorType, status])
  @@map("operator_profiles")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}


model AuthIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  provider        String
  providerSubject String
  handle          String?
  email           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId, provider])
  @@map("auth_identities")
}

model UserRpcSetting {
  userId                  String   @id @db.Uuid
  customSolanaRpcUrl      String?
  customSolanaWsUrl       String?
  heliusApiKeyCiphertext  String?
  heliusApiKeyIv          String?
  heliusApiKeyTag         String?
  updatedAt               DateTime @updatedAt
  createdAt               DateTime @default(now())
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_rpc_settings")
}

model CapitalPot {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String
  organizationId    String?  @db.Uuid
  title             String
  currency          String   @default("USD")
  targetMinor       Decimal  @db.Decimal(40, 0)
  raisedMinor       Decimal  @default(0) @db.Decimal(40, 0)
  platformFeeBps    Int      @default(250)
  status            String   @default("OPEN")
  stripePriceLabel  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  contributions     CapitalContribution[]

  @@index([projectId, status])
  @@map("capital_pots")
}

model CapitalContribution {
  id                    String   @id @default(uuid()) @db.Uuid
  potId                 String   @db.Uuid
  userId                String?  @db.Uuid
  amountMinor           Decimal  @db.Decimal(40, 0)
  currency              String
  provider              String
  providerSessionId     String?  @unique
  providerPaymentId     String?  @unique
  status                String   @default("PREPARED")
  platformFeeMinor      Decimal? @db.Decimal(40, 0)
  createdAt             DateTime @default(now())
  confirmedAt           DateTime?
  pot                   CapitalPot @relation(fields: [potId], references: [id], onDelete: Restrict)

  @@index([potId, status, createdAt])
  @@map("capital_contributions")
}

model LedgerJournal {
  id              String   @id @default(uuid()) @db.Uuid
  reference       String   @unique
  type            String
  status          String   @default("POSTED")
  source          String
  sourceId        String?
  userId          String?  @db.Uuid
  metadata        Json?
  createdAt       DateTime @default(now())
  postings        LedgerPosting[]

  @@index([type, createdAt])
  @@map("ledger_journals")
}

model LedgerPosting {
  id          String   @id @default(uuid()) @db.Uuid
  journalId   String   @db.Uuid
  account     String
  direction   String
  amountMinor Decimal  @db.Decimal(40, 0)
  asset       String
  createdAt   DateTime @default(now())
  journal     LedgerJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@index([account, asset, createdAt])
  @@map("ledger_postings")
}

model XTipRecord {
  id             String   @id @default(uuid()) @db.Uuid
  recipientUserId String? @db.Uuid
  senderUserId    String? @db.Uuid
  xHandle         String
  amountMinor     Decimal  @db.Decimal(40, 0)
  currency        String   @default("USD")
  status          String   @default("SELF_REPORTED")
  externalUrl     String
  evidenceNote    String?
  createdAt       DateTime @default(now())

  @@index([xHandle, createdAt])
  @@map("x_tip_records")
}

model SavedPrompt {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  prompt    String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("saved_prompts")
}
