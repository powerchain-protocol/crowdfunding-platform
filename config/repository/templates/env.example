# PowerChain Crowdfunding v1.0.0 — local development environment
# Create .env.local with: pnpm env:init
# Never commit .env.local or production credentials.
# Only NEXT_PUBLIC_* values may be exposed to browser bundles.

# -----------------------------------------------------------------------------
# Runtime / safety mode
# -----------------------------------------------------------------------------
NODE_ENV=development
POWERCHAIN_ENV=development
POWERCHAIN_NETWORK=devnet
POWERCHAIN_DATA_MODE=mock
POWERCHAIN_WRITE_MODE=simulated
POWERCHAIN_INFRA_REQUIRED=false
POWERCHAIN_INFRA_WAIT_MS=30000

# -----------------------------------------------------------------------------
# Local applications
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_CROWDFUNDING_URL=http://localhost:3001
NEXT_PUBLIC_DONATE_URL=http://localhost:3002
NEXT_PUBLIC_CHECKOUT_URL=http://localhost:3003
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3004
NEXT_PUBLIC_TREASURY_URL=http://localhost:3005
NEXT_PUBLIC_ADMIN_URL=http://localhost:3006
NEXT_PUBLIC_EXPLORER_URL=http://localhost:3007
NEXT_PUBLIC_DOCS_URL=http://localhost:3008
NEXT_PUBLIC_PWA_URL=http://localhost:3009
NEXT_PUBLIC_API_URL=http://localhost:3010
# Leave blank on localhost. In production, use a shared parent domain such as .powerchain.ventures.
NEXT_PUBLIC_WALLET_COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Docker / PostgreSQL / Redis
# Defaults are intentionally local-only and match infra/docker-compose.yml.
# Change local passwords before exposing the services beyond 127.0.0.1.
# -----------------------------------------------------------------------------
POWERCHAIN_DOCKER_BIND=127.0.0.1
NODE_VERSION=24.19.0
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=powerchain
POSTGRES_USER=powerchain
POSTGRES_PASSWORD=powerchain_local_change_me
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256 --auth-local=scram-sha-256
DATABASE_URL=postgresql://powerchain:powerchain_local_change_me@127.0.0.1:5432/powerchain?schema=public

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=powerchain_redis_local_change_me
REDIS_URL=redis://:powerchain_redis_local_change_me@127.0.0.1:6379
QUEUE_URL=

# -----------------------------------------------------------------------------
# Auth / SaaS
# -----------------------------------------------------------------------------
AUTH_SESSION_TTL_SECONDS=43200
AUTH_DEV_EXPOSE_RESET_TOKEN=false
SAAS_DEFAULT_PLAN=STARTER
SAAS_TRIAL_DAYS=14
SAAS_ENFORCE_ENTITLEMENTS=true

# -----------------------------------------------------------------------------
# Realtime
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ACTIVITY_POLL_INTERVAL_MS=10000
NEXT_PUBLIC_ACTIVITY_POLL_MS=10000
NEXT_PUBLIC_DEAL_ROOM_POLL_INTERVAL_MS=5000
NEXT_PUBLIC_ACTIVITY_WS_URL=
ACTIVITY_WS_URL=

# -----------------------------------------------------------------------------
# UI / locale
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FORCE_RTL=false

# -----------------------------------------------------------------------------
# Solana / Helius — server-side RPC selection
# Public Solana endpoints are suitable for development/fallback only. For
# production traffic, configure Helius dedicated or Secure RPC URLs.
# Helius API keys must never be exposed through NEXT_PUBLIC_* variables.
# -----------------------------------------------------------------------------
SOLANA_CLUSTER=devnet
SOLANA_RPC_PROVIDER=auto

# Official public Solana RPC fallbacks
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_MAINNET_RPC_URL=https://api.mainnet.solana.com
SOLANA_DEVNET_WS_URL=wss://api.devnet.solana.com
SOLANA_MAINNET_WS_URL=wss://api.mainnet.solana.com

# Active compatibility aliases. Keep these aligned with SOLANA_CLUSTER when
# overriding manually. The server resolver prefers explicit Helius URLs first.
SOLANA_RPC_URL=
SOLANA_WS_URL=

# Helius credentials / RPCs. Leave URL values blank to let server code build
# the standard URL from HELIUS_API_KEY. Secure URLs are copied from the Helius
# dashboard and contain no visible API key.
HELIUS_API_KEY=
# Standard endpoint formats (leave assignment fields below blank or paste real URLs):
# https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY
# https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
# wss://devnet.helius-rpc.com/?api-key=YOUR_API_KEY
# wss://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
HELIUS_DEVNET_RPC_URL=
HELIUS_MAINNET_RPC_URL=
HELIUS_DEVNET_WS_URL=
HELIUS_MAINNET_WS_URL=
HELIUS_DEVNET_SECURE_RPC_URL=
HELIUS_MAINNET_SECURE_RPC_URL=

# Canonical Solana program IDs used by the platform. These are public IDs, not
# signing keys. Source-declared PowerChain IDs are listed below but stay unverified.
SOLANA_SYSTEM_PROGRAM_ID=11111111111111111111111111111111
SOLANA_TOKEN_PROGRAM_ID=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
SOLANA_TOKEN_2022_PROGRAM_ID=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
SOLANA_ASSOCIATED_TOKEN_PROGRAM_ID=ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL

# Canonical PowerChain Token-2022 mainnet mint. A devnet mint must be configured
# separately; never reuse a mainnet deployment reference as a devnet address.
PWRC_MAINNET_MINT_ADDRESS=PWRCRXXZxbg6FdQZfK3PMD7KP8xfxs9acvifJiG46wc
PWRC_DEVNET_MINT_ADDRESS=
PWRC_DECIMALS=9

# PowerChain source-declared program IDs. Presence does not prove deployment; keep VERIFIED=false until on-chain verification.
CROWDFUNDING_PROGRAM_ID=Crwd111111111111111111111111111111111111111
CROWDFUNDING_PROGRAM_VERIFIED=false
REGISTRY_PROGRAM_ID=Reg1111111111111111111111111111111111111111
REGISTRY_PROGRAM_VERIFIED=false
CONTRIBUTORS_PROGRAM_ID=Cont111111111111111111111111111111111111111
CONTRIBUTORS_PROGRAM_VERIFIED=false
SOLANA_MILESTONE_ESCROW_PROGRAM_ID=
SOLANA_MILESTONE_ESCROW_VERIFIED=false

# Other chains
SUI_RPC_URL=
EVM_RPC_URL=

# -----------------------------------------------------------------------------
# Payments / settlement providers
# Demo is the safe default. Provider secrets belong in .env.local or a secret
# manager, never in this example or any NEXT_PUBLIC_* variable.
# -----------------------------------------------------------------------------
PAYMENTS_MODE=demo
MIDTRANS_SERVER_KEY=
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_FINISH_URL=http://localhost:3003/checkout/complete
MONERIUM_CLIENT_ID=

# -----------------------------------------------------------------------------
# Supabase + Prisma/PostgreSQL
# -----------------------------------------------------------------------------
# Browser-safe Supabase values. The publishable key is designed for client use
# together with RLS; it must never be treated as an authorization bypass.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase values. SERVICE_ROLE bypasses RLS and must remain secret.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Prisma uses DATABASE_URL for application traffic. For local Docker, the value
# above is correct. When using Supabase, use the Supavisor Session pooler (5432)
# for a long-lived server. DIRECT_URL is optional in this v1 schema/toolchain and
# can hold the direct/session migration URL for deployment tooling.
DIRECT_URL=
SHADOW_DATABASE_URL=

# Production RLS verification test identities / fixture IDs
RLS_TEST_USER_EMAIL=
RLS_TEST_USER_PASSWORD=
RLS_TEST_PROFILE_ID=
RLS_TEST_VERIFICATION_CHECK_ID=
RLS_TEST_ESCROW_TRANCHE_ID=

# ---------------------------------------------------------------------------
# UI preferences / wallet mode
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_SOLANA_NETWORK=devnet
NEXT_PUBLIC_EMBEDDED_WALLET_ENABLED=false
EMBEDDED_WALLET_ENABLED=false
EMBEDDED_WALLET_PROVIDER=
EMBEDDED_WALLET_START_URL=

# Creator authentication / OAuth
AUTH_APP_URL=http://127.0.0.1:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GOOGLE_CALLBACK_URL=http://127.0.0.1:3000/api/auth/callback/google
AUTH_X_ID=
AUTH_X_SECRET=
AUTH_X_CALLBACK_URL=http://127.0.0.1:3000/api/auth/callback/x
AUTH_REMEMBER_DAYS=27
AUTH_FINGERPRINT_SECRET=
ENABLE_DEMO_AUTH=false
SEED_DEMO_USERS=false
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false

# User-owned provider secrets
# 32-byte key encoded as base64 or 64 hex chars; required before storing user Helius keys.
USER_SECRET_ENCRYPTION_KEY=

# Stripe project capital pots
STRIPE_MODE=disabled
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
