{
  "name": "@powerchain/ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./theme.css": "./src/theme.css",
    "./theme-provider": "./src/theme-provider.tsx",
    "./locale-provider": "./src/locale-provider.tsx",
    "./icons": "./src/icons.tsx",
    "./web3-icons": "./src/web3-icons.tsx",
