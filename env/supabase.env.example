# Supabase + Prisma provider inventory (copy values into .env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Prisma/PostgreSQL
# Server/long-lived deployment: Supavisor Session pooler on 5432 is supported.
# For a serverless runtime, use the connection mode appropriate to your host and
# keep a separate direct/session URL for migrations when required.
DATABASE_URL=
DIRECT_URL=
SHADOW_DATABASE_URL=
