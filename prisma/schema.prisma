generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model Campaign {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  purpose       String
  participation String
  status        String
  targetAmount  Decimal  @db.Decimal(30, 9)
  currency      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  paymentIntents PaymentIntent[]
}

model PaymentIntent {
  id              String   @id @default(cuid())
  campaignId      String
  amount          Decimal  @db.Decimal(30, 9)
  displayCurrency String
  paymentMethod   String
  settlementAsset String
  status          String
  reference       String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  campaign        Campaign @relation(fields: [campaignId], references: [id])
}

model AuditEvent {
  id                String   @id @default(cuid())
  sequence          BigInt   @unique @default(autoincrement())
  type              String
  actorId           String?
  organizationId    String?
  resourceType      String
  resourceId        String
  requestId         String?
  correlationId     String?
  metadata          Json?
  payloadHash       String
  previousEventHash String?
  eventHash         String   @unique
  createdAt         DateTime @default(now())
  @@index([resourceType, resourceId, sequence])
}

model VerificationCheck {
  id                String   @id @default(cuid())
  subjectId         String
  subjectType       String
  type              String
  status            String
  providerReference String?
  verifiedAt        DateTime?
  expiresAt         DateTime?
  reviewerId        String?
  reasonCode        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model IdentityDocument {
  id          String   @id @default(cuid())
  checkId     String
  kind        String
  fileName    String
  contentType String
  sizeBytes   Int
  sha256      String
  storageKey  String
  createdAt   DateTime @default(now())
  @@unique([checkId, sha256])
}

model AgreementTemplate {
  id                String
  name              String
  version           String
  jurisdiction      String?
  counselApprovedAt DateTime?
  counselReference  String?
  content           String
  contentHash       String
  createdAt         DateTime @default(now())
  @@id([id, version])
}

model Agreement {
  id                  String   @id @default(cuid())
  campaignId          String
  templateId          String
  templateVersion     String
  status              String
  dealTerms           Json
  renderedContentHash String
  supersedesId        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AgreementSignature {
  id                String   @id @default(cuid())
  agreementId       String
  signerUserId      String
  signerName        String
  signerRole        String
  signedContentHash String
  consentVersion    String
  requestId         String
  ipHash            String?
  userAgentHash     String?
  signedAt          DateTime @default(now())
  @@unique([agreementId, signerUserId, signedContentHash])
}

model CampaignEscrow {
  id         String   @id @default(cuid())
  campaignId String
  treasuryId String
  status     String
  asset      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EscrowTranche {
  id                   String   @id @default(cuid())
  escrowId             String
  campaignId           String
  milestoneId          String
  label                String
  amountMinor          Decimal  @db.Decimal(40, 0)
  asset                String
  status               String
  platformFeeBpsSnapshot Int?
  fundedAt             DateTime?
  releaseTransactionId String?
  releasedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  channel   String
  status    String
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model NotificationPreference {
  id        String @id @default(cuid())
  userId    String
  type      String
  inApp     Boolean @default(true)
  email     Boolean @default(true)
  @@unique([userId, type])
}

model ModerationReport {
  id             String   @id @default(cuid())
  reporterUserId String?
  resourceType   String
  resourceId     String
  reason         String
  details        String?
  status         String
  severity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([resourceType, resourceId, createdAt])
}

model ModerationAction {
  id         String   @id @default(cuid())
  reportId   String?
  resourceType String
  resourceId String
  action     String
  reasonCode String
  actorId    String?
  automatic  Boolean  @default(false)
  createdAt  DateTime @default(now())
}


model FounderListing {
  id                 String   @id @default(uuid()) @db.Uuid
  slug               String   @unique
  founderUserId      String   @db.Uuid
  organizationId     String   @db.Uuid
  productName        String
  tagline             String
  category            String
  stage               String
  location            String
  pitchDeckStorageKey String?
  demoVideoStorageKey String?
  status              String   @default("DRAFT")
  verificationStatus  String   @default("PENDING")
  verified            Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("founder_listings")
}

model ListingTranche {
  id                String   @id @default(uuid()) @db.Uuid
  listingId         String   @db.Uuid
  ordinal           Int
  title             String
  amountMinor       Decimal  @db.Decimal(40, 0)
  milestoneSummary  String
  proofRequirements Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([listingId, ordinal])
  @@map("listing_tranches")
}

model InvestorOffer {
  id             String   @id @default(uuid()) @db.Uuid
  listingId      String   @db.Uuid
  investorUserId String   @db.Uuid
  amountMinor    Decimal  @db.Decimal(40, 0)
  currency       String
  termsJson      Json
  status         String   @default("SUBMITTED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("investor_offers")
}

model WatchlistItem {
  userId    String   @db.Uuid
  listingId String   @db.Uuid
  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@map("watchlist_items")
}

model DealRoom {
  id        String   @id @default(uuid()) @db.Uuid
  listingId String   @db.Uuid
  offerId   String?  @db.Uuid
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@map("deal_rooms")
}

model DealRoomParticipant {
  roomId          String   @db.Uuid
  userId          String   @db.Uuid
  participantRole String
  createdAt       DateTime @default(now())

  @@id([roomId, userId])
  @@map("deal_room_participants")
}

model DealRoomMessage {
  id           String   @id @default(uuid()) @db.Uuid
  roomId       String   @db.Uuid
  senderUserId String   @db.Uuid
  kind         String
  body         String?
  createdAt    DateTime @default(now())
  editedAt     DateTime?

  @@map("deal_room_messages")
}

model DealRoomAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  roomId         String   @db.Uuid
  uploaderUserId String   @db.Uuid
  storageKey     String
  fileName       String
  contentType    String
  sizeBytes      BigInt
  sha256         String
  createdAt      DateTime @default(now())

  @@map("deal_room_attachments")
}

model MilestoneProof {
  id                   String   @id @default(uuid()) @db.Uuid
  escrowTrancheId      String   @db.Uuid
  submitterUserId      String   @db.Uuid
  ipfsUri              String
  sha256               String
  status               String   @default("SUBMITTED")
  verifiedByInvestorId String?  @db.Uuid
  verifiedAt           DateTime?
  createdAt            DateTime @default(now())

  @@map("milestone_proofs")
}

model OrganizationProfile {
  id                 String   @id @default(cuid())
  organizationId     String   @unique
  legalName          String
  tradingName        String?
  entityType         String
  registrationNumber String?
  taxId              String?
  foundationNumber   String?
  foundationPurpose  String?
  foundedAt          DateTime?
  website            String?
  billingEmail       String?
  phone              String?
  logoObjectKey      String?
  description        String?
  registeredAddress  Json?
  socialLinks        Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model InvoiceRecord {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  status         String
  currency       String
  issuerSnapshot Json
  customerSnapshot Json
  lines          Json
  fees           Json?
  discountAmount Decimal? @db.Decimal(30, 9)
  settlement     Json?
  notes          String?
  paymentTerms   String?
  auditHash      String?
  issuedAt       DateTime
  dueAt          DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, status])
}
