# PowerChain Crowdfunding v1.0.0 — production environment inventory
# Values are intentionally blank unless they are public protocol constants.
# Store real credentials in the deployment secret manager, never in Git.
NODE_ENV=production
POWERCHAIN_ENV=production
POWERCHAIN_NETWORK=mainnet-beta
POWERCHAIN_DATA_MODE=tba
POWERCHAIN_WRITE_MODE=disabled
POWERCHAIN_INFRA_REQUIRED=true

# Cross-app public URLs / wallet-session cookie domain
NEXT_PUBLIC_WEB_URL=https://powerchain.ventures
NEXT_PUBLIC_DASHBOARD_URL=https://app.powerchain.ventures
NEXT_PUBLIC_WALLET_COOKIE_DOMAIN=.powerchain.ventures

# Prisma/PostgreSQL
DATABASE_URL=
DIRECT_URL=
SHADOW_DATABASE_URL=
REDIS_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Solana public fallbacks + dedicated Helius production RPCs
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC_PROVIDER=helius
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
SOLANA_MAINNET_RPC_URL=https://api.mainnet.solana.com
SOLANA_DEVNET_WS_URL=wss://api.devnet.solana.com
SOLANA_MAINNET_WS_URL=wss://api.mainnet.solana.com
SOLANA_RPC_URL=
SOLANA_WS_URL=
HELIUS_API_KEY=
# Standard endpoint formats (leave assignment fields below blank or paste real URLs):
# https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY
# https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
# wss://devnet.helius-rpc.com/?api-key=YOUR_API_KEY
# wss://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
HELIUS_DEVNET_RPC_URL=
HELIUS_MAINNET_RPC_URL=
HELIUS_DEVNET_WS_URL=
HELIUS_MAINNET_WS_URL=
HELIUS_DEVNET_SECURE_RPC_URL=
HELIUS_MAINNET_SECURE_RPC_URL=

SOLANA_SYSTEM_PROGRAM_ID=11111111111111111111111111111111
SOLANA_TOKEN_PROGRAM_ID=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
SOLANA_TOKEN_2022_PROGRAM_ID=TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
SOLANA_ASSOCIATED_TOKEN_PROGRAM_ID=ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL
PWRC_MAINNET_MINT_ADDRESS=PWRCRXXZxbg6FdQZfK3PMD7KP8xfxs9acvifJiG46wc
PWRC_DEVNET_MINT_ADDRESS=
PWRC_DECIMALS=9

# PowerChain source-declared program IDs; keep VERIFIED=false until on-chain verification.
CROWDFUNDING_PROGRAM_ID=Crwd111111111111111111111111111111111111111
CROWDFUNDING_PROGRAM_VERIFIED=false
REGISTRY_PROGRAM_ID=Reg1111111111111111111111111111111111111111
REGISTRY_PROGRAM_VERIFIED=false
CONTRIBUTORS_PROGRAM_ID=Cont111111111111111111111111111111111111111
CONTRIBUTORS_PROGRAM_VERIFIED=false
SOLANA_MILESTONE_ESCROW_PROGRAM_ID=
SOLANA_MILESTONE_ESCROW_VERIFIED=false

SUI_RPC_URL=
EVM_RPC_URL=

# Payments/providers
PAYMENTS_MODE=provider
MIDTRANS_SERVER_KEY=
MONERIUM_CLIENT_ID=

# ---------------------------------------------------------------------------
# UI preferences / wallet mode
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_SOLANA_NETWORK=devnet
NEXT_PUBLIC_EMBEDDED_WALLET_ENABLED=false
EMBEDDED_WALLET_ENABLED=false
EMBEDDED_WALLET_PROVIDER=
EMBEDDED_WALLET_START_URL=

# Creator authentication / OAuth
AUTH_APP_URL=https://studio.powerchain.app
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GOOGLE_CALLBACK_URL=https://studio.powerchain.app/api/auth/callback/google
AUTH_X_ID=
AUTH_X_SECRET=
AUTH_X_CALLBACK_URL=https://studio.powerchain.app/api/auth/callback/x
AUTH_REMEMBER_DAYS=27
AUTH_FINGERPRINT_SECRET=
ENABLE_DEMO_AUTH=false
SEED_DEMO_USERS=false
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false

# User-owned provider secrets
# 32-byte key encoded as base64 or 64 hex chars; required before storing user Helius keys.
USER_SECRET_ENCRYPTION_KEY=

# Stripe project capital pots
STRIPE_MODE=live
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
